#: core/ui/settings_new.cpp:6933
msgid "Per Game VMU Rename Warning"
msgstr "Varning vid namnbyte av VMU per spel"

#: core/ui/settings_new.cpp:6935
msgid ""
"This looks like an auto-named Per Game VMU for A1.\n"
"Renaming it can stop Hollycast from auto-loading it while Per Game VMUs is enabled.\n"
"To restore automatic pickup later, rename it back to its original file name."
msgstr ""
"Detta verkar vara en automatiskt namngiven VMU för A1 per spel.\n"
"Om du byter namn på den kan Hollycast sluta läsa in den automatiskt när VMU per spel är aktiverat.\n"
"Byt tillbaka till det ursprungliga filnamnet om du senare vill återaktivera automatisk igenkänning."

#: core/ui/settings_new.cpp:6940
msgid "New name"
msgstr "Nytt namn"

#: core/ui/settings_new.cpp:6987
msgid "No VMU selected."
msgstr "Ingen VMU har valts."

