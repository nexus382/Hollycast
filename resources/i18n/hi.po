#: core/cheats.cpp:1005 core/cheats.cpp:1034
msgid "Unsupported conditional code"
msgstr "शर्त वाला कोड समर्थित नहीं है"

#: core/cheats.cpp:1015
msgid "Missing test address"
msgstr "जाँच का पता अनुपस्थित है"

#: core/cheats.cpp:1116
msgid "Can't save cheat file"
msgstr "चीट फ़ाइल सहेज नहीं सके"

#: core/ui/settings_new.cpp:4474 core/ui/settings_new.cpp:4514
msgid "Graphics API"
msgstr "ग्राफ़िक्स API"

#: core/ui/settings_video.cpp:96
msgid ""
"MoltenVK: An implementation of Vulkan that runs on Apple's Metal graphics "
"framework"
msgstr ""
"MoltenVK, Vulkan का ऐसा कार्यान्वयन है जो Apple के Metal ग्राफ़िक्स "
"फ़्रेमवर्क पर चलता है।"

#: core/ui/settings_new.cpp:4590
msgid "Transparent Sorting"
msgstr "पारदर्शी वस्तुओं की छँटाई"

#: core/ui/settings_new.cpp:4604
msgid "Per Triangle"
msgstr "प्रति त्रिभुज"

#: core/ui/settings_video.cpp:123
msgid ""
"Sort transparent polygons per triangle. Fast but may produce graphical "
"glitches"
msgstr ""
"पारदर्शी बहुभुजों को हर त्रिभुज के आधार पर क्रम में लगाएँ। यह तेज़ है, लेकिन"
" इससे ग्राफ़िक्स में गड़बड़ियाँ आ सकती हैं।"

#: core/ui/settings_new.cpp:4606
msgid "Per Strip"
msgstr "प्रति स्ट्रिप"

#: core/ui/settings_video.cpp:127
msgid ""
"Sort transparent polygons per strip. Faster but may produce graphical "
"glitches"
msgstr ""
"पारदर्शी बहुभुजों को हर स्ट्रिप के आधार पर क्रम में लगाएँ। यह ज़्यादा तेज़ "
"है, लेकिन इससे ग्राफ़िक्स में गड़बड़ियाँ आ सकती हैं।"

#: core/ui/settings_new.cpp:4601
msgid "Per Pixel"
msgstr "प्रति पिक्सेल"

#: core/ui/settings_video.cpp:133
msgid "Sort transparent polygons per pixel. Slower but accurate"
msgstr ""
"पारदर्शी बहुभुजों को हर पिक्सेल के आधार पर क्रम में लगाएँ। यह धीमा है, लेकिन"
" सटीक है।"

#: core/ui/settings_new.cpp:4705
msgid "Rendering Options"
msgstr "रेंडरिंग विकल्प"

#: core/ui/settings_new.cpp:4714
msgid "Half"
msgstr "आधा"

#: core/ui/settings_new.cpp:4714
msgid "Native"
msgstr "नेटिव"

#: core/ui/settings_new.cpp:4749
msgid "Internal Resolution"
msgstr "आंतरिक रिज़ॉल्यूशन"

#: core/ui/settings_video.cpp:203
msgid ""
"Internal render resolution. Higher is better, but more demanding on the GPU."
" Values higher than your display resolution (but no more than double your "
"display resolution) can be used for supersampling, which provides high-"
"quality antialiasing without reducing sharpness."
msgstr ""
"आंतरिक रेंडर रिज़ॉल्यूशन। ज़्यादा रिज़ॉल्यूशन बेहतर दिखता है, लेकिन GPU पर "
"अधिक भार डालता है। अपने डिस्प्ले रिज़ॉल्यूशन से ऊँचे मानों का उपयोग "
"सुपर-सैंपलिंग के लिए किया जा सकता है, पर वे डिस्प्ले रिज़ॉल्यूशन के दोगुने "
"से अधिक नहीं होने चाहिए। सुपर-सैंपलिंग से तीक्ष्णता घटाए बिना उच्च गुणवत्ता "
"वाला एंटी-अलियासिंग मिलता है।"

#: core/ui/settings_new.cpp:4793
msgid "Integer Scaling"
msgstr "पूर्णांक स्केलिंग"

#: core/ui/settings_video.cpp:204
msgid ""
"Scales the output by the maximum integer multiple allowed by the display "
"resolution."
msgstr ""
"डिस्प्ले रिज़ॉल्यूशन जितनी अनुमति देता है, आउटपुट को पूर्णांक गुणक से स्केल "
"करता है।"

#: core/ui/settings_new.cpp:4807
msgid "Linear Interpolation"
msgstr "रैखिक इंटरपोलेशन"

#: core/ui/settings_video.cpp:205
msgid ""
"Scales the output with linear interpolation. Will use nearest neighbor "
"interpolation otherwise. Disable with integer scaling."
msgstr ""
"आउटपुट को रैखिक इंटरपोलेशन से स्केल करता है। अन्यथा निकटतम-पड़ोसी इंटरपोलेशन"
" का उपयोग होगा। पूर्णांक स्केलिंग चालू हो तो इसे बंद कर दें।"

#: core/ui/settings_new.cpp:4822
msgid "VSync"
msgstr "VSync"

#: core/ui/settings_video.cpp:207
msgid "Synchronizes the frame rate with the screen refresh rate. Recommended"
msgstr ""
"फ़्रेम दर को स्क्रीन की रिफ़्रेश दर के साथ सिंक्रोनाइज़ करता है। अनुशंसित।"

#: core/ui/settings_new.cpp:4839
msgid "Frame Pacing (Experimental)"
msgstr "फ़्रेम समय-निर्धारण (प्रायोगिक)"

#: core/ui/settings_new.cpp:4840 core/ui/settings_new.cpp:4843
msgid ""
"Provide the GPU with presentation timing for each frame to replicate "
"original frame pacing."
msgstr ""
"मूल फ़्रेम समय-निर्धारण को दोहराने के लिए GPU को हर फ़्रेम के प्रस्तुतीकरण "
"का समय बताता है।"

#: core/ui/settings_video.cpp:216
msgid "Duplicate frames"
msgstr "फ़्रेम डुप्लिकेट करें"

#: core/ui/settings_video.cpp:216
msgid "Duplicate frames on high refresh rate monitors (120 Hz and higher)"
msgstr "120 Hz या उससे अधिक रिफ़्रेश दर वाले मॉनिटर पर फ़्रेम डुप्लिकेट करें"

#: core/ui/settings_video.cpp:221
msgid "Show VMU In-game"
msgstr "गेम के दौरान VMU दिखाएँ"

#: core/ui/settings_video.cpp:221
msgid "Show the VMU LCD screens while in-game"
msgstr "गेम के दौरान VMU की LCD स्क्रीन दिखाएँ"

#: core/ui/settings_new.cpp:4871
msgid "Full Framebuffer Emulation"
msgstr "पूरा फ़्रेमबफ़र अनुकरण"

#: core/ui/settings_video.cpp:223
msgid ""
"Fully accurate VRAM framebuffer emulation. Helps games that directly access "
"the framebuffer for special effects. Very slow and incompatible with "
"upscaling and wide screen."
msgstr ""
"VRAM फ़्रेमबफ़र का पूरी सटीकता से अनुकरण करता है। विशेष प्रभावों के लिए सीधे"
" फ़्रेमबफ़र तक पहुँचने वाले गेम में मदद करता है। यह बहुत धीमा है और "
"अपस्केलिंग तथा वाइडस्क्रीन के साथ संगत नहीं है।"

#: core/ui/settings_new.cpp:4885
msgid "Load Custom Textures"
msgstr "कस्टम टेक्सचर लोड करें"

#: core/ui/settings_video.cpp:228
msgid "Load custom/high-res textures from data/textures/<game id>"
msgstr "data/textures/<game id> से कस्टम/उच्च-रिज़ॉल्यूशन टेक्सचर लोड करें"

#: core/ui/settings_new.cpp:4911
msgid "Preload Custom Textures"
msgstr "कस्टम टेक्सचर पहले से लोड करें"

#: core/ui/settings_video.cpp:233
msgid ""
"Preload custom textures at game start. May improve performance but increases"
" memory usage"
msgstr ""
"गेम शुरू होने पर कस्टम टेक्सचर पहले से लोड करें। इससे प्रदर्शन बेहतर हो सकता"
" है, लेकिन मेमोरी का उपयोग बढ़ेगा।"

#: core/ui/settings_new.cpp:4941
msgid "Aspect Ratio"
msgstr "आस्पेक्ट रेशियो"

#: core/ui/settings_new.cpp:4946
msgid "Widescreen"
msgstr "वाइडस्क्रीन"

#: core/ui/settings_video.cpp:242
msgid ""
"Draw geometry outside of the normal 4:3 aspect ratio. May produce graphical glitches in the revealed areas.\n"
"Aspect Fit and shows the full 16:9 content."
msgstr ""
"सामान्य 4:3 आस्पेक्ट रेशियो से बाहर की ज्यामिति बनाएँ। इससे दिखने वाले हिस्सों में ग्राफ़िक्स संबंधी गड़बड़ियाँ हो सकती हैं।\n"
"आस्पेक्ट फ़िट का उपयोग करके 16:9 की पूरी सामग्री दिखाता है।"

#: core/ui/settings_new.cpp:4961
msgid "Super Widescreen"
msgstr "सुपर वाइडस्क्रीन"

#: core/ui/settings_video.cpp:248
msgid ""
"Use the full width of the screen or window when its aspect ratio is greater than 16:9.\n"
"Aspect Fill and remove black bars. Not compatible with integer scaling."
msgstr ""
"जब स्क्रीन या विंडो का आस्पेक्ट रेशियो 16:9 से अधिक हो, तब उसकी पूरी चौड़ाई का उपयोग करें।\n"
"आस्पेक्ट फ़िल का उपयोग करके काली पट्टियाँ हटाता है। पूर्णांक स्केलिंग के साथ संगत नहीं है।"

#: core/ui/settings_new.cpp:4977
msgid "Widescreen Game Cheats"
msgstr "वाइडस्क्रीन गेम चीट्स"

#: core/ui/settings_video.cpp:252
msgid ""
"Modify the game so that it displays in 16:9 anamorphic format and use "
"horizontal screen stretching. Only some games are supported."
msgstr ""
"गेम को इस तरह बदलता है कि वह 16:9 एनामॉर्फ़िक फ़ॉर्मैट में दिखे, और क्षैतिज "
"स्क्रीन स्ट्रेचिंग का उपयोग करता है। केवल कुछ गेम समर्थित हैं।"

#: core/ui/settings_new.cpp:4999
msgid "Horizontal Stretching"
msgstr "क्षैतिज स्ट्रेचिंग"

#: core/ui/settings_video.cpp:254
msgid "Stretch the screen horizontally"
msgstr "स्क्रीन को क्षैतिज दिशा में फैलाएँ"

#: core/ui/settings_new.cpp:5030
msgid "Rotate Screen 90°"
msgstr "स्क्रीन 90° घुमाएँ"

#: core/ui/settings_video.cpp:255
msgid "Rotate the screen 90° counterclockwise"
msgstr "स्क्रीन को 90° वामावर्त घुमाएँ"

#: core/ui/settings_new.cpp:5042
msgid "Per Pixel Settings"
msgstr "प्रति-पिक्सेल सेटिंग्स"

#: core/ui/settings_video.cpp:263
msgid "512 MB"
msgstr "512 MB"

#: core/ui/settings_video.cpp:263
msgid "1 GB"
msgstr "1 GB"

#: core/ui/settings_video.cpp:263
msgid "2 GB"
msgstr "2 GB"

#: core/ui/settings_video.cpp:263
msgid "4 GB"
msgstr "4 GB"

#: core/ui/settings_new.cpp:5058
msgid "Pixel Buffer Size"
msgstr "पिक्सेल बफ़र का आकार"

#: core/ui/settings_video.cpp:303
msgid ""
"The size of the pixel buffer. May need to be increased when upscaling by a "
"large factor."
msgstr ""
"पिक्सेल बफ़र का आकार। बड़े अनुपात में अपस्केल करने पर इसे बढ़ाना पड़ सकता "
"है।"

#: core/ui/settings_new.cpp:5101
msgid "Maximum Layers"
msgstr "अधिकतम लेयर"

#: core/ui/settings_video.cpp:306
msgid ""
"Maximum number of transparent layers. May need to be increased for some "
"complex scenes. Decreasing it may improve performance."
msgstr ""
"पारदर्शी लेयरों की अधिकतम संख्या। कुछ जटिल दृश्यों के लिए इसे बढ़ाना पड़ "
"सकता है। इसे घटाने से प्रदर्शन बेहतर हो सकता है।"

#: core/ui/settings_new.cpp:5138
msgid "Performance"
msgstr "प्रदर्शन"

#: core/ui/settings_video.cpp:311
msgid "Automatic Frame Skipping:"
msgstr "फ़्रेम स्किपिंग अपने-आप:"

#: core/ui/settings_new.cpp:2158 core/ui/settings_new.cpp:5143
#: core/ui/settings_new.cpp:5315 core/ui/settings_new.cpp:7750
#: core/ui/settings_new.cpp:7866
msgid "Disabled"
msgstr "बंद"

#: core/ui/settings_video.cpp:313
msgid "No frame skipping"
msgstr "फ़्रेम स्किप न करें"

#: core/ui/settings_new.cpp:5143
msgid "Normal"
msgstr "सामान्य"

#: core/ui/settings_video.cpp:315
msgid "Skip a frame when the GPU and CPU are both running slow"
msgstr "जब GPU और CPU, दोनों धीमे चल रहे हों, तब एक फ़्रेम छोड़ें"

#: core/ui/settings_new.cpp:5143
msgid "Maximum"
msgstr "अधिकतम"

#: core/ui/settings_video.cpp:317
msgid "Skip a frame when the GPU is running slow"
msgstr "जब GPU धीमा चल रहा हो, तब एक फ़्रेम छोड़ें"

#: core/ui/settings_new.cpp:5181
msgid "Frame Skipping"
msgstr "फ़्रेम स्किपिंग"

#: core/ui/settings_video.cpp:321
msgid "Number of frames to skip between two actually rendered frames"
msgstr ""
"असल में रेंडर किए गए दो फ़्रेमों के बीच छोड़े जाने वाले फ़्रेमों की संख्या"

#: core/ui/settings_new.cpp:5217
msgid "Shadows"
msgstr "छायाएँ"

#: core/ui/settings_video.cpp:323
msgid "Enable modifier volumes, usually used for shadows"
msgstr ""
"मॉडिफ़ायर वॉल्यूम चालू करें; इनका उपयोग आम तौर पर छायाओं के लिए होता है"

#: core/ui/settings_new.cpp:5231
msgid "Fog"
msgstr "कोहरा"

#: core/ui/settings_video.cpp:324
msgid "Enable fog effects"
msgstr "कोहरे के प्रभाव चालू करें"

#: core/ui/gui_menu.cpp:628 core/ui/settings_new.cpp:2352
#: core/ui/settings_new.cpp:5245
msgid "Advanced"
msgstr "उन्नत"

#: core/ui/settings_new.cpp:5257
msgid "Delay Frame Swapping"
msgstr "फ़्रेम बदलने में देरी"

#: core/ui/settings_video.cpp:330
msgid ""
"Useful to avoid flashing screen or glitchy videos. Not recommended on slow "
"platforms"
msgstr ""
"स्क्रीन की चमकती झिलमिलाहट या वीडियो की गड़बड़ियों से बचने में उपयोगी। धीमे "
"प्लेटफ़ॉर्म पर इसकी अनुशंसा नहीं की जाती।"

#: core/ui/settings_new.cpp:5272
msgid "Fix Upscale Bleeding Edge"
msgstr "अपस्केलिंग में टेक्सचर का रंग रिसना ठीक करें"

#: core/ui/settings_video.cpp:332
msgid ""
"Helps with texture bleeding case when upscaling. Disabling it can help if "
"pixels are warping when upscaling in 2D games (MVC2, CVS, KOF, etc.)"
msgstr ""
"अपस्केल करते समय टेक्सचर के रंग रिसने की समस्या में मदद करता है। 2D गेम "
"अपस्केल करते समय पिक्सेल खिंचें या टेढ़े दिखें, तो इसे बंद करने से मदद मिल "
"सकती है (MVC2, CVS, KOF आदि)।"

#: core/ui/settings_new.cpp:5286
msgid "Native Depth Interpolation"
msgstr "नेटिव डेप्थ इंटरपोलेशन"

#: core/ui/settings_video.cpp:334
msgid ""
"Helps with texture corruption and depth issues on AMD GPUs. Can also help "
"Intel GPUs in some cases."
msgstr ""
"AMD GPU पर टेक्सचर बिगड़ने और डेप्थ संबंधी समस्याओं में मदद करता है। कुछ "
"मामलों में Intel GPU पर भी मदद कर सकता है।"

#: core/ui/settings_video.cpp:335
msgid "Copy Rendered Textures to VRAM"
msgstr "रेंडर किए गए टेक्सचर VRAM में कॉपी करें"

#: core/ui/settings_video.cpp:336
msgid "Copy rendered-to textures back to VRAM. Slower but accurate"
msgstr ""
"रेंडर किए गए टेक्सचर को वापस VRAM में कॉपी करें। यह धीमा है, लेकिन सटीक है।"

#: core/ui/settings_new.cpp:5328
msgid "Anisotropic Filtering"
msgstr "एनिसोट्रॉपिक फ़िल्टरिंग"

#: core/ui/settings_video.cpp:377
msgid ""
"Higher values make textures viewed at oblique angles look sharper, but are "
"more demanding on the GPU. This option only has a visible impact on "
"mipmapped textures."
msgstr ""
"ऊँचे मानों से तिरछे कोणों पर दिखने वाले टेक्सचर अधिक स्पष्ट होते हैं, लेकिन "
"GPU पर ज़्यादा भार पड़ता है। इस विकल्प का असर केवल mipmap वाले टेक्सचर पर "
"दिखाई देता है।"

#: core/ui/settings_video.cpp:379
msgid "Texture Filtering:"
msgstr "टेक्सचर फ़िल्टरिंग:"

#: core/ui/settings_new.cpp:2787 core/ui/settings_new.cpp:2811
#: core/ui/settings_new.cpp:2834 core/ui/settings_new.cpp:5356
#: core/ui/vgamepad.cpp:109 core/ui/vgamepad.cpp:117 core/ui/vgamepad.cpp:1355
msgid "Default"
msgstr "डिफ़ॉल्ट"

#: core/ui/settings_video.cpp:381
msgid "Use the game's default texture filtering"
msgstr "गेम की डिफ़ॉल्ट टेक्सचर फ़िल्टरिंग का उपयोग करें"

#: core/ui/settings_new.cpp:5357
msgid "Force Nearest-Neighbor"
msgstr "निकटतम-पड़ोसी फ़िल्टरिंग लागू करें"

#: core/ui/settings_video.cpp:383
msgid ""
"Force nearest-neighbor filtering for all textures. Crisper appearance, but "
"may cause various rendering issues. This option usually does not affect "
"performance."
msgstr ""
"सभी टेक्सचर पर निकटतम-पड़ोसी फ़िल्टरिंग लागू करें। इससे छवि अधिक स्पष्ट "
"दिखती है, लेकिन रेंडरिंग की कई समस्याएँ आ सकती हैं। आम तौर पर इस विकल्प से "
"प्रदर्शन पर असर नहीं पड़ता।"

#: core/ui/settings_new.cpp:5358
msgid "Force Linear"
msgstr "रैखिक फ़िल्टरिंग लागू करें"

#: core/ui/settings_video.cpp:385
msgid ""
"Force linear filtering for all textures. Smoother appearance, but may cause "
"various rendering issues. This option usually does not affect performance."
msgstr ""
"सभी टेक्सचर पर रैखिक फ़िल्टरिंग लागू करें। इससे छवि अधिक चिकनी दिखती है, "
