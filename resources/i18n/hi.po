msgstr "LanguageSetting"

#: core/ui/settings_new.cpp:2801
msgid "Dreamcast BIOS language (affects game text/menus)."
msgstr "Dreamcast BIOS की भाषा (गेम के पाठ और मेनू पर असर पड़ता है)।"

#: core/ui/settings_new.cpp:2804
msgid ""
"Language\n"
"Sets the Dreamcast BIOS language that games read for menus and text.\n"
"Most games will follow this setting; some may ignore it.\n"
"\n"
"Arcade platforms typically use automatic region/language behavior."
msgstr ""
"भाषा\n"
"गेम मेनू और पाठ के लिए Dreamcast BIOS की भाषा सेट करता है।\n"
"अधिकांश गेम इस सेटिंग का पालन करेंगे; कुछ गेम इसे अनदेखा कर सकते हैं।\n"
"\n"
"आर्केड प्लेटफ़ॉर्म आम तौर पर क्षेत्र और भाषा अपने-आप चुनते हैं।"

