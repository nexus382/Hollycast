#: core/ui/settings_new.cpp:3644
msgid ""
"UI Scaling\n"
"Adjusts UI element sizes.\n"
"Useful on high-DPI displays, TVs, or small screens.\n"
"\n"
"After applying, the UI will reinitialize to apply the new scale."
msgstr ""
"Ridimensionamento interfaccia\n"
"Regola le dimensioni degli elementi dell'interfaccia.\n"
"Utile su schermi ad alta densità di pixel, televisori o schermi piccoli.\n"
"\n"
"Dopo l'applicazione, l'interfaccia verrà reinizializzata per applicare la nuova scala."

#: core/ui/settings_new.cpp:3655
msgid "Hide legacy Naomi file types in the content browser."
msgstr "Nascondi i tipi di file Naomi meno recenti nel browser dei contenuti."

#: core/ui/settings_new.cpp:3662
msgid ""
"Hide Legacy Naomi ROMs\n"
"Hides `.bin`, `.dat`, and `.lst` files from the content browser.\n"
"Useful if you have mixed Naomi sets and only want to see launchable content."
msgstr ""
"Nascondi le vecchie ROM Naomi\n"
"Nasconde i file `.bin`, `.dat` e `.lst` dal browser dei contenuti.\n"
"Utile se hai set Naomi misti e vuoi visualizzare solo i contenuti avviabili."

#: core/ui/settings_new.cpp:3673
msgid "Android storage picker integration."
msgstr "Integrazione con il selettore di archiviazione Android."

#: core/ui/settings_new.cpp:3677
msgid ""
"Use SAF File Picker\n"
"Uses Android's Storage Access Framework (SAF) for file browsing.\n"
"This can improve compatibility with scoped storage and content providers on newer Android versions."
msgstr ""
"Usa il selettore file SAF\n"
"Usa Storage Access Framework (SAF) di Android per sfogliare i file.\n"
"Può migliorare la compatibilità con l'archiviazione con ambito limitato e i provider di contenuti nelle versioni recenti di Android."

