#: core/ui/settings_video.cpp:85
msgid "Graphics API"
msgstr "图形 API"

#: core/ui/settings_video.cpp:96
msgid ""
"MoltenVK: An implementation of Vulkan that runs on Apple's Metal graphics "
"framework"
msgstr "MoltenVK：一款可在苹果Metal图形框架上运行的Vulkan实现"

#: core/ui/settings_video.cpp:116
msgid "Transparent Sorting"
msgstr "透明物体顺序渲染"

#: core/ui/settings_video.cpp:121
msgid "Per Triangle"
msgstr "按三角形计算"

#: core/ui/settings_video.cpp:123
msgid ""
"Sort transparent polygons per triangle. Fast but may produce graphical "
"glitches"
msgstr "按三角形对透明多边形进行排序。速度快，但可能会导致图形异常"

#: core/ui/settings_video.cpp:125
msgid "Per Strip"
msgstr "按条带排序"

#: core/ui/settings_video.cpp:127
msgid ""
"Sort transparent polygons per strip. Faster but may produce graphical "
"glitches"
msgstr "按条带对透明多边形进行排序。速度更快，但可能会产生图形故障"

#: core/ui/settings_video.cpp:131
msgid "Per Pixel"
msgstr "按像素排序"

#: core/ui/settings_video.cpp:133
msgid "Sort transparent polygons per pixel. Slower but accurate"
msgstr "按像素对透明多边形进行排序。速度较慢，但准确"

#: core/ui/settings_video.cpp:153
msgid "Rendering Options"
msgstr "渲染选项"

#: core/ui/settings_video.cpp:156
msgid "Half"
msgstr "一半分辨率"

#: core/ui/settings_video.cpp:156 core/ui/settings_network.cpp:40
msgid "Native"
msgstr "原生"

#: core/ui/settings_video.cpp:201
msgid "Internal Resolution"
msgstr "内部渲染分辨率"

#: core/ui/settings_video.cpp:203
msgid ""
"Internal render resolution. Higher is better, but more demanding on the GPU."
" Values higher than your display resolution (but no more than double your "
"display resolution) can be used for supersampling, which provides high-"
"quality antialiasing without reducing sharpness."
msgstr ""
"内部渲染分辨率。数值越高，图形质量越好，但对GPU的要求也越高。高于显示器分辨率（但不超过显示器分辨率两倍）的数值可用于超采样，从而在不降低清晰度的前提下提供高质量的抗锯齿效果"

#: core/ui/settings_video.cpp:204
msgid "Integer Scaling"
msgstr "整数缩放"

#: core/ui/settings_video.cpp:204
msgid ""
"Scales the output by the maximum integer multiple allowed by the display "
"resolution."
msgstr "根据显示分辨率允许的最大整数倍对输出进行缩放"

#: core/ui/settings_video.cpp:205
msgid "Linear Interpolation"
msgstr "线性插值"

#: core/ui/settings_video.cpp:205
msgid ""
"Scales the output with linear interpolation. Will use nearest neighbor "
"interpolation otherwise. Disable with integer scaling."
msgstr "使用线性插值对输出进行缩放。否则将使用最近邻插值。启用整数缩放时将禁用此功能"

#: core/ui/settings_video.cpp:207
msgid "VSync"
msgstr "垂直同步"

#: core/ui/settings_video.cpp:207
msgid "Synchronizes the frame rate with the screen refresh rate. Recommended"
msgstr "将帧率与屏幕刷新率同步。建议使用"

#: core/ui/settings_video.cpp:212
msgid "Frame Pacing (Experimental)"
msgstr "帧速率控制（实验性功能）"

#: core/ui/settings_video.cpp:213
msgid ""
"Provide the GPU with presentation timing for each frame to replicate "
"original frame pacing."
msgstr "为 GPU 提供每帧的呈现时序，以重现原始帧的节奏"

#: core/ui/settings_video.cpp:216
msgid "Duplicate frames"
msgstr "重复帧"

