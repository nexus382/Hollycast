msgstr "UILanguageSetting"

#: core/ui/settings_new.cpp:2775
msgid "Language used by Hollycast menus and settings."
msgstr "Hollycast 菜单和设置使用的语言。"

#: core/ui/settings_new.cpp:2778
msgid ""
"UI Language\n"
"Changes the language used by Hollycast menus, settings, notifications, and other app UI.\n"
"System Default follows your device language when a translation is available.\n"
"\n"
"Game text is controlled separately by Dreamcast Language below."
msgstr ""
"界面语言\n"
"控制 Hollycast 菜单、设置、通知和其他应用界面的语言。\n"
"如果有可用翻译，“系统默认”会使用设备语言。\n"
"\n"
"下方的 Dreamcast 语言设置会单独控制游戏文本。"

#: core/ui/settings_new.cpp:2792
msgid "LanguagePopup"
msgstr "LanguagePopup"

#: core/ui/settings_new.cpp:2797 core/ui/settings_new.cpp:2821
#: core/ui/settings_new.cpp:2871
