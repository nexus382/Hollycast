#: core/ui/settings_new.cpp:8847
msgid ""
"Profiler\n"
"Enables performance profiling tools for developers and power users.\n"
"\n"
"This can add overhead. Leave it off unless you are actively profiling performance."
msgstr ""

#: core/ui/settings_new.cpp:8859
msgid "Display in GUI"
msgstr ""

#: core/ui/settings_new.cpp:8860
msgid "Show profiler overlay"
msgstr ""

#: core/ui/settings_new.cpp:8864
msgid ""
"Profiler: Display in GUI\n"
"Draws profiler output as an in-game overlay.\n"
"\n"
"Useful for quickly spotting spikes or expensive subsystems while reproducing a performance issue."
msgstr ""

