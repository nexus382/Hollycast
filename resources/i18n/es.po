#: core/ui/settings_new.cpp:6933
msgid "Per Game VMU Rename Warning"
msgstr "Aviso al cambiar el nombre de la VMU por juego"

#: core/ui/settings_new.cpp:6935
msgid ""
"This looks like an auto-named Per Game VMU for A1.\n"
"Renaming it can stop Hollycast from auto-loading it while Per Game VMUs is enabled.\n"
"To restore automatic pickup later, rename it back to its original file name."
msgstr ""
"Parece una VMU A1 por juego con nombre automático.\n"
"Si le cambias el nombre mientras está activada la opción de VMU por juego, Hollycast podría dejar de cargarla automáticamente.\n"
"Para restaurar la carga automática más adelante, vuelve a ponerle el nombre de archivo original."

#: core/ui/settings_new.cpp:6940
msgid "New name"
msgstr "Nombre nuevo"

#: core/ui/settings_new.cpp:6987
msgid "No VMU selected."
msgstr "No se ha seleccionado ninguna VMU."

