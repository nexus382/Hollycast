{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "binaryDir": "build",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "USE_DISCORD": "ON"
            },
            "hidden": true
        },
        {
            "name": "windows",
            "inherits": ["base"],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux",
            "inherits": ["base"],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "darwin",
            "inherits": ["base"],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_XCODE_GENERATE_SCHEME": "YES",
                "USE_BREAKPAD": "NO",
                "MOLTENVK_DYLIB": "/usr/local/lib/libMoltenVK.dylib"
            },
            "generator": "Xcode"
        },
        {
            "name": "windows-debug",
            "description": "Convenience alias for windows preset.",
            "inherits": ["windows"],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-debug",
            "inherits": ["linux"],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "binaryDir": "build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "darwin-debug",
            "description": "Convenience alias for darwin preset.",
            "inherits": ["darwin"],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows-unit-tests-debug",
            "inherits": ["windows-debug"],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "binaryDir": "build-unit-tests-debug",
            "cacheVariables": {
                "ENABLE_CTEST": "ON"
            }
        },
        {
            "name": "linux-unit-tests-debug",
            "inherits": ["linux-debug"],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "binaryDir": "build-unit-tests-debug",
            "cacheVariables": {
                "ENABLE_CTEST": "ON"
            }
        },
        {
            "name": "darwin-jitless",
            "description": "macOS arm64 build using the cached SHIL VM (no native codegen).",
            "inherits": ["darwin"],
            "binaryDir": "build-jitless",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "JITLESS": "ON",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
                "USE_BREAKPAD": "NO",
                "MOLTENVK_DYLIB": "/opt/homebrew/lib/libMoltenVK.dylib"
            }
        },
        {
            "name": "darwin-jitless-tests",
            "description": "macOS arm64 jitless build with gtest (cached SHIL VM).",
            "inherits": ["darwin-jitless"],
            "binaryDir": "build-jitless-tests",
            "cacheVariables": {
                "ENABLE_CTEST": "ON",
                "USE_VULKAN": "OFF",
                "USE_DISCORD": "OFF"
            }
        },
        {
            "name": "darwin-jit-tests",
            "description": "macOS arm64 JIT build with gtest, to benchmark against darwin-jitless-tests.",
            "inherits": ["darwin"],
            "binaryDir": "build-jit-tests",
            "cacheVariables": {
                "JITLESS": "OFF",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
                "ENABLE_CTEST": "ON",
                "USE_VULKAN": "OFF",
                "USE_DISCORD": "OFF",
                "MOLTENVK_DYLIB": "/opt/homebrew/lib/libMoltenVK.dylib"
            }
        },
        {
            "name": "ios-jitless",
            "description": "iOS device build with cached SHIL VM (no JIT / no native codegen).",
            "inherits": ["base"],
            "generator": "Xcode",
            "binaryDir": "build-ios",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
                "CMAKE_XCODE_GENERATE_SCHEME": "YES",
                "JITLESS": "ON",
                "USE_BREAKPAD": "NO",
                "USE_VULKAN": "OFF",
                "USE_DISCORD": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows",
            "configurePreset": "windows",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "linux",
            "configurePreset": "linux",
            "environment": {
                "MAKEFLAGS": "-j", "$comment": "max parallelism"
            }
        },
        {
            "name": "darwin",
            "configurePreset": "darwin",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "windows-debug",
            "inherits": ["windows"],
            "configurePreset": "windows-debug",
            "configuration": "Debug"
        },
        {
            "name": "linux-debug",
            "inherits": ["linux"],
            "configurePreset": "linux-debug"
        },
        {
            "name": "darwin-debug",
            "inherits": ["darwin"],
            "configurePreset": "darwin-debug",
            "configuration": "Debug"
        },
        {
            "name": "windows-unit-tests-debug",
            "configurePreset": "windows-unit-tests-debug",
            "configuration": "Debug"
        },
        {
            "name": "linux-unit-tests-debug",
            "configurePreset": "linux-unit-tests-debug",
            "configuration": "Debug"
        },
        {
            "name": "darwin-jitless",
            "configurePreset": "darwin-jitless",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "darwin-jitless-tests",
            "configurePreset": "darwin-jitless-tests",
            "configuration": "Debug"
        },
        {
            "name": "ios-jitless",
            "configurePreset": "ios-jitless",
            "configuration": "RelWithDebInfo"
        }
    ]
}
